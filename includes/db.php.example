<?php
define('DB_HOST', 'mysql.rackhost.hu');
define('DB_USER', 'your_db_user');
define('DB_PASS', 'your_db_password');
define('DB_NAME', 'your_db_name');
define('SITE_URL', 'https://czeczokrisztian.hu');

define('SMTP_HOST', 'smtp.rackhost.hu');
define('SMTP_PORT', 465);
define('SMTP_USER', 'your_smtp_user');
define('SMTP_PASS', 'your_smtp_password');
define('SMTP_FROM', 'your_smtp_user');
define('SMTP_FROM_NAME', 'Látogatói Rendszer');

// Secret used to authorize HTTP-triggered cron scripts (e.g. cron/purge_expired.php)
define('CRON_SECRET', 'change-me-to-a-random-string');

// Secret used to sign the "remember this device" cookie issued by gate.php
// (the shared site-password gate in front of the public kiosk + admin login).
// Independent from CRON_SECRET so rotating one doesn't invalidate the other.
define('SITE_GATE_SECRET', 'change-me-to-a-different-random-string');

function getDB(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $pdo = new PDO(
            'mysql:host=' . DB_HOST . ';dbname=' . DB_NAME . ';charset=utf8mb4',
            DB_USER, DB_PASS,
            [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            ]
        );
    }
    return $pdo;
}
